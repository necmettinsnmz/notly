{
  "manifest_version": 3,
  "name": "Notly — Akıllı Ders Dinleyici & Sınav Notu",
  "version": "1.0.0",
  "description": "Canlı dersleri (Moodle, Zoom, Teams, YouTube) dinler, slaytları yakalar ve 4 modlu sınav notu çıkarır.",
  "permissions": [
    "tabs",
    "tabCapture",
    "offscreen",
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Notly Yan Panelini Aç"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
